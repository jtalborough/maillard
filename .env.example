# Maillard Configuration
# Copy this file to .env and adjust values as needed

# ── Required ─────────────────────────────────────────────
# AI Agent (optional — leave blank to disable AI roast assistant)
ANTHROPIC_API_KEY=
MAILLARD_AI_LIVE_MODEL=claude-haiku-4-5-20251001
MAILLARD_AI_PLAN_MODEL=claude-sonnet-4-5-20250929

# ── Roaster ──────────────────────────────────────────────
MAILLARD_KALEIDO_HOST=192.0.2.10
MAILLARD_KALEIDO_PORT=80
MAILLARD_KALEIDO_PATH=ws

# ── Database ─────────────────────────────────────────────
# Non-secret connection settings. For authenticated production deployments,
# mount only the username/password keys as read-only files and set these paths.
# mongodb+srv is intentionally unsupported; use explicit host/port/file settings.
MAILLARD_MONGODB_HOST=localhost
MAILLARD_MONGODB_PORT=27017
MAILLARD_MONGODB_NAME=maillard
MAILLARD_MONGODB_AUTH_SOURCE=admin
# MAILLARD_MONGODB_USERNAME_FILE=/run/secrets/mongodb-username
# MAILLARD_MONGODB_PASSWORD_FILE=/run/secrets/mongodb-password

# ── Safety Limits (Celsius) ──────────────────────────────
MAILLARD_MAX_BT_TEMP=230.0
MAILLARD_MAX_ET_TEMP=280.0
MAILLARD_MAX_ROR=20.0
MAILLARD_MIN_ROR=3.0
MAILLARD_MAX_ROAST_DURATION=1200

# AI control. The watchdog only emergency-stops while the AI is in Auto; in
# manual/suggest it just warns. Production NAS deploys set this true.
MAILLARD_AI_AUTO_CONTROL_ENABLED=true

# ── Web Server ───────────────────────────────────────────
# In Docker, the Dockerfile CMD overrides these with 0.0.0.0:8080.
# These only apply when running from source (python -m maillard web).
MAILLARD_API_HOST=127.0.0.1
MAILLARD_API_PORT=8080

# ── Label Printing (Zebra ZD421) ─────────────────────────
# CUPS printing (preferred — best quality via Zebra CUPS driver):
# MAILLARD_ZEBRA_CUPS_NAME=Zebra_Technologies_ZTC_ZD421_300dpi_ZPL
# MAILLARD_ZEBRA_CUPS_DARKNESS=25
# Transport: auto (CUPS if configured, otherwise TCP), cups, or tcp.
# tcp forces ZPL even with CUPS configured. auto falls back to TCP if lp is missing
# (the Docker image has no cups-client), provided ZEBRA_HOST is set.
# MAILLARD_ZEBRA_TRANSPORT=auto
# TCP/ZPL printing:
# MAILLARD_ZEBRA_HOST=192.0.2.20
# MAILLARD_ZEBRA_PORT=9100
# QR pages use MAILLARD_SITE_URL/r/<roast-code> (default https://roastery.example.com).
# Printing requires matching site sync and effective published=true; override bypasses this.
# MAILLARD_LABEL_BASE_URL is deprecated; retained only as a QR base override.
# Label style: classic, craft-parchment, craft-bw (default: classic)
# MAILLARD_LABEL_DEFAULT_STYLE=classic
# Custom label styles directory (drop YAML files here for extra styles)
# MAILLARD_LABEL_STYLES_DIR=

# Storefront site ingest
MAILLARD_SITE_URL=https://roastery.example.com
# Generate with openssl rand -hex 32; use the same value as Vercel.
# MAILLARD_INGEST_SECRET=
# Mounted secret file overrides the environment value.
# MAILLARD_INGEST_SECRET_FILE=

# ── CORS ─────────────────────────────────────────────────
# Comma-separated origins. Leave blank to allow all private IPs (default).
# Example: http://192.0.2.50:3000,http://nas.local:8080
MAILLARD_CORS_ORIGINS=

# ── Logging ──────────────────────────────────────────────
MAILLARD_LOG_LEVEL=INFO
# Log format: "text" (human-readable) or "json" (structured, for log aggregation)
MAILLARD_LOG_FORMAT=text
MAILLARD_LOG_FILE=logs/maillard.log
